// 官网部署配置 —— nordic.airacle.com
//
// 为什么是 Worker + 静态资源，而不是 Cloudflare Pages：
// 这个账号的 **Pages 项目数已经到上限**（建新项目报 code 8000027），
// 而删掉别人的站点来腾位置是不可接受的。Worker 带静态资源是现在官方推荐的
// 静态站做法，配额独立（这个账号 40 个 worker，还有余量），能力也够：
// 目录直出、自动处理 /plan/ → /plan/index.html、自带 CDN 和证书。
//
// 2026-09-23 加了一个 Worker 脚本（原来是纯静态）：打包清单要能在**手机和电脑上都勾**，
// 而 localStorage / cookie 是按设备存的 → 必须有共同存储点。/api/pack 走 KV，
// 其余所有路径仍然由 assets 直出（binding=ASSETS，worker 里 fallback 给它）。
{
  "name": "nordic-trip-2026",
  "compatibility_date": "2026-01-01",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // /photos/* 一律先进 worker → 转给相册 worker（否则 assets 的 404 页会先接住）
    "run_worker_first": ["/photos", "/photos/*"]
  },
  // 共享相册是单独的 worker（photos/，名字 nordic-photos），经 service binding 挂在 /photos/ 下：
  // 同域 → 同一套导航和样式、cookie 不跨站；相册自己挂了也不影响主站。
  "services": [{ "binding": "PHOTOS", "service": "nordic-photos" }],
  "kv_namespaces": [
    { "binding": "PACK", "id": "710b23e0205b43759cfd6eb6f75e9d08" }
  ],
  // custom_domain 会自动建 DNS 记录并签边缘证书，不用手工加 CNAME
  "routes": [{ "pattern": "nordic.airacle.com", "custom_domain": true }]
}
