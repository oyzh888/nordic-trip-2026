# 复制成 .env 再填。⛔ .env 不进 git、不贴到聊天里、不打印（只打长度）。令牌：openssl rand -hex 32
COLD_DATA_DIR=/volume1/photos-cold        # NAS 上放原件的目录（要有足够空间：相册现在约 400 GB，按 1 TB 留）
BLOBD_TOKEN=                               # 全权限（读写删）—— 只在 compose 内网用，绝不出隧道
BLOBD_EDGE_TOKEN=                          # 只读 + 删 —— 同一个值要设成 Cloudflare Worker 的 secret COLD_TOKEN
BLOBD_PROCS=4
ENGINE_URL=https://nordic.airacle.com      # 相册地址（不带 /photos）
PIPE_TOKEN=                                # 相册的 GPU / 搬运工令牌，向 Steve 要，别打印
MOVER_ARGS=--limit 20                      # 阶段 2 金丝雀；阶段 3 改成空；阶段 5 加 --release-after-days 14
TUNNEL_TOKEN=                              # 用 --profile tunnel 起新隧道时才需要
